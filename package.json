{
  "name": "royal-alert",
  "version": "1.0.2",
  "description": "A lightweight, zero-dependency alternative to SweetAlert2 for modern JavaScript alerts, toasts, and modals.",
  "main": "dist/royal-alert.umd.js",
  "module": "dist/royal-alert.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/royal-alert.mjs",
      "require": "./dist/royal-alert.umd.js",
      "types": "./types/index.d.ts"
    },
    "./dist/royal-alert.css": "./dist/royal-alert.css",
    "./dist/royal-alert.min.css": "./dist/royal-alert.min.css"
  },
  "style": "dist/royal-alert.css",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite serve demo",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "keywords": [
    "alert",
    "toast",
    "modal",
    "dialog",
    "notification",
    "popup",
    "vanilla-js",
    "zero-dependency"
  ],
  "author": {
    "name": "Royal Technologies",
    "email": "info@royaltechbd.com",
    "url": "https://www.royaltechbd.com/"
  },
  "license": "MIT",
  "homepage": "https://royal-technologies.github.io/RoyalAlert/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Royal-Technologies/RoyalAlert.git"
  },
  "devDependencies": {
    "jsdom": "^23.0.0",
    "terser": "^5.51.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
